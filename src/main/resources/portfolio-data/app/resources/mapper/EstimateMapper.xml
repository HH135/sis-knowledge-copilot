<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acme.svc.estimate.EstimateDao">
    <update id="create" statementType="CALLABLE">
        { call dbo.USP_CREATE_ESTIMATE(#{estimateNo}, #{orderNo}, #{laborAmount}, #{partAmount}) }
    </update>
    <update id="approve" statementType="CALLABLE">
        { call dbo.USP_APPROVE_ESTIMATE(#{estimateNo}) }
    </update>
</mapper>
