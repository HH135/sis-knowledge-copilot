<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acme.svc.appointment.AppointmentDao">
    <update id="register" statementType="CALLABLE">
        { call dbo.USP_REGISTER_APPOINTMENT(#{appointmentNo}, #{customerNo}, #{vin}, NULL, #{appointmentAt}, NULL) }
    </update>
    <update id="confirm" statementType="CALLABLE">
        { call dbo.USP_CONFIRM_APPOINTMENT(#{appointmentNo}, #{bayNo}) }
    </update>
</mapper>
